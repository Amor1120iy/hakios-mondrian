# HakiOS fragment: the SM8475 family -- what is true of the SoC, whatever phone it is in.
# (the reference phone's sc7280.config is the model: the same symbols, the values of this chip)
CONFIG_SOC="sm8475"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
