# HakiOS fragment: the Redmi K60 (mondrian) -- what is true of this device and of no other.
#
# The state of the port is devices/mondrian/device.conf's; this file is the same state as a configuration. What is
# on here is what has a path to working without a driver being changed for this phone:
#   - the SoC's own blocks (frequency, sensors, identity, PMIC, buttons, UFS), from the sm8475 fragment;
#   - the storage, at the reference phone's addresses (UFS 0x1d84000, the same phy);
#   - UEFI's framebuffer for the display, which needs no driver of this phone's.
# What is off is off because the driver is the reference phone's hardware, not this phone's: see README.md, which
# pairs each line with the file and the line that has to change before it can be turned on.
CONFIG_DEVICE="mondrian"
CONFIG_UFS=2

# the SM8475 sensor layout (drivers/power/hakios.thermal.c, thermal_map): 16 channels a block, and the
# four cpu-0-* are on block 1 next to aoss-1, not block 0 as on the reference phone.
CONFIG_THERMAL_MAP="sm8475"

# the modem's RMTFS buffer: free memory below 4 GB between the bootloader's tail (0xa7400000) and the display's
# reservation (0xb8000000); 0xa8000000 is free here as well as on the reference phone
# CONFIG_MODEM_BUFFER is not set

# --- off until the driver is this phone's ---------------------------------------------------------------
# Adreno 730: hakios.adreno.c describes one GPU (642L) and hakios-metal accepts one chip id (0x06030500)
# CONFIG_GPU is not set
# CONFIG_HAKIOS_ADRENO is not set
# WCN6856: the driver is WCN6750's ath11k, with its firmware and board data
# CONFIG_WIFI is not set
# CONFIG_HAKIOS_WIFI is not set
# the DSP's firmware differs, and the amplifiers are AW882XX, not Cirrus
# CONFIG_ADSP is not set
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
# CONFIG_SOUND is not set
# the battery level comes through the DSP, so it waits for the DSP
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# a PM8350B hh-haptics, not an AW86927
# CONFIG_HAPTIC is not set
# CONFIG_HAKIOS_HAPTIC is not set
# the reference phone's sensors
# CONFIG_CAM is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# the touch driver's bus, pins and supplies are the POCO X5 Pro's (QUP4 gpio16-19, irq 21, reset 20, avdd 71 here)
# CONFIG_TOUCHSCREEN is not set
# CONFIG_HAKIOS_GOODIX is not set
# the pins are the reference phone's, and the firmware is not pulled
# CONFIG_HAKIOS_BT is not set
# the addresses are in soc.args, but the modem's IPA and firmware are this phone's own (ipa_fws at 0x8b900000)
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
